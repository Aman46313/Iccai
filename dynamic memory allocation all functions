void rellocArrayExpand()
{
    int *ptri,i,n,size1,size2;
    printf("How many numbers you need to process:");
    scanf("%d",&size1);
    ptri=(int*)calloc(size1,sizeof(int));
    for(i=0;i<size1;i++)
    {
        scanf("%d",ptri+i);
    }
    printf("entered array elements:\n");
    for(i=0;i<size1;i++)
    {
        printf("%d\n",*(ptri+i));
    }
    printf("enter the new elements for array:");
    scanf("%d",&size2);
    ptri=(int*)realloc(ptri,(size1+size2)*sizeof(int));
     for(i=size1;i<size1+size2;i++)
    {
        scanf("%d",ptri+i);
    }
    printf("entered array elements:\n");
    for(i=0;i<size1+size2;i++)
    {
        printf("%d\n",*(ptri+i));
    }

}
