#include <stdio.h>
#include <stdlib.h>
int main()
{
    int *arr;
    int i;

    arr = (int*) malloc(10 * sizeof(int));
    if (arr == NULL)
    {
        printf("Initial malloc failed!\n");
        return 1;
    }
    for (i=0;i<10;i++)
    {
        arr[i]=i+1;
    }
    printf("Original array elements:\n");
    for (i=0;i <10;i++)
    {
        printf("%d\n",arr[i]);
    }
    printf("\n");
    int *temp = realloc(arr, 20* sizeof(int));
    if (temp == NULL)
     {
        printf("Reallocation failed!\n");
        free(arr);
        return 1;
    }
    arr = temp;
    for (i=10;i<20;i++)
    {
        arr[i]=(i+1)*20;
    }

    printf("Resized array 20 elements:\n");
    for (i=0;i<20;i++)
    {
        printf("%d\n",arr[i]);
    }
    printf("\n");
    free(arr);

    return 0;
}
