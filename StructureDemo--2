void mallocDemo()
{
    int *ptri;
    ptri=(int *)malloc(1*sizeof(int));
    if(ptri==0)
    {
        printf("Memory is not allocated\n");
        return ;
    }
    else
    {
        printf("Enter the value:");
        scanf("%d",ptri);
        printf("Entered the value variable:%d\n",*ptri);
        printf("Entered the address of a value:%u\n",ptri);
    }
}
void callocDemo()
{
    int *ptri;
    ptri=(int *)calloc(1,sizeof(int));
    if(ptri==0)
    {
        printf("Memory is not allocated\n");
        return ;
    }
    else
    {
        printf("Enter the value:");
        scanf("%d",ptri);
        printf("Entered the value variable:%d\n",*ptri);
        printf("Entered the address of a value:%u\n",ptri);
    }
}
void ExpandingReAlloc()
{
    int *ptri,size1,size2,i;
    printf("Enter the no element you want:");
    scanf("%d",&size1);
    printf("Enter the %d elements\n",size1);
    ptri=(int *)calloc(size1,sizeof(int));
    for(i=0;i<size1;i++)
    {
        scanf("%d",ptri+i);
    }
    printf("Enter the extra value:");
    scanf("%d",&size2);
    ptri=(int *)realloc(ptri,(size1+size2)*sizeof(int));
    printf("Enter the %d elements\n",size2);
    for(i=size1;i<size1+size2;i++)
    {
        scanf("%d",ptri+i);
    }
    printf("Entered the array elements\n");
    for(i=0;i<size1+size2;i++)
    {
        printf("%d\n",*(ptri+i));
    }
}
void shrinkingReAllocDemo()
{
    int *ptri,size1,size2,i;
    printf("Enter the no element you want:");
    scanf("%d",&size1);
    printf("Enter the %d elements\n",size1);
    ptri=(int *)calloc(size1,sizeof(int));
    for(i=0;i<size1;i++)
    {
        scanf("%d",ptri+i);
    }
    printf("Enter the how to print the array elements:");
    scanf("%d",&size2);
    ptri=(int *)realloc(ptri,(size1+size2)*sizeof(int));
    printf("Entered the array elements\n");
    for(i=0;i<size2;i++)
    {
        printf("%d\n",*(ptri+i));
    }
}
void callByValueDemo(int a,int b)
{
    a++;b++;
    printf("Sum:%d\n",a+b);
}
void callByReferenceDemo(int*a,int*b)
{
    *a=*a+2;
    *b=*b+2;
    printf("Sum:%d\n",(*a+*b));
}
void swaping(int *a,int *b)
{
    int temp;
    temp=*a;
    *a=*b;
    *b=temp;
}

