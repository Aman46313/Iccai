#include<stdio.h>
void SelfRefrentialStructure();
int main()
{
    SelfRefrentialStructure();
}
void SelfRefrentialStructure()
{
    int i,n;
    printf("Enter how much candidates you want to store:");
    scanf("%d",&n);
    struct person
    {
        char name[10];
        int age;
        int idno;
        struct person*next;
    };
    struct person p[n];
    for(i=0;i<n;i++)
    {
        printf("Enter the %d of candidates:",i+1);
        scanf("%s",&p[i].name);
        printf("Enter the age of candidate:");
        scanf("%d",&p[i].age);
        printf("Enter the idno of candidate:");
        scanf("%d",&p[i].idno);
        printf("\n\n");
    }
    for(i=0;i<n;i++)
    {
        printf("\n***********************\n");
        printf("%d person data\n",i+1);
        printf("Name:%s\n",p[i].name);
        printf("name:%d\n",p[i].age);
        printf("nmae:%d\n",p[i].idno);
        p[i].next=&p[i+1];
        printf("address of next person %u\n",p[i].next+i);
    }
}
