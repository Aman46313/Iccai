#include<stdio.h>
#include<stdlib.h>
#include"pointers.h"
 int main()
 {
    int a=5,b=10;
     int choice;
     while(1)
     {
         printf("Enter the choice:\n");
         printf("1.Call by value\n2.Call by reference\n3.exit\n");
         scanf("%d",&choice);
         switch(choice)
         {
             case 1: printf("*****Call by value*****\n");
                     printf("Before the call by value a:%d\tb=%d\n",a,b);
                     callByValue(a,b);
                     printf("After call by value a:%d\tb=%d\n",a,b);break;
             case 2: printf("*****Call by reference*****\n");
                     printf("Before the call by reference value a:%d\tb=%d\n",a,b);
                     callByReference(&a,&b);
                     printf("After call by reference value a:%d\tb=%d\n",a,b);break;
            case 3:exit(1);break;
         }
     }
 }

void callByValue(int,int);
void callByReference(int*,int*);


void callByValue(int a,int b)
{
    a++;b++;
    printf("Sum:%d\n",(a+b));
}
void callByReference(int*a,int*b)
{
    *a=*a+2;
    *b=*b+2;
    printf("Sum:%d\n",(*a+*b));
}

