#include<stdio.h>
#include<stdlib.h>
#include"pointers.h"
#include"arrays.h"
 int main()
 {
    int a=5,b=10;
     int choice;
     while(1)
     {
         printf("Enter the choice:\n");
         printf("1.Call by value\n2.Call by reference\n3.Create Array\n4.Array Accessing\n5.Swaping\n6.exit\n");
         scanf("%d",&choice);
         switch(choice)
         {
             case 1: printf("*****Call by value*****\n");
                     printf("Before the call by value a:%d\tb=%d\n",a,b);
                     callByValue(a,b);
                     printf("After call by value a:%d\tb=%d\n\n",a,b);break;
             case 2: printf("*****Call by reference*****\n");
                     printf("Before the call by reference value a:%d\tb=%d\n",a,b);
                     callByReference(&a,&b);
                     printf("After call by reference value a:%d\tb=%d\n\n",a,b);break;
             case 3: createArray();break;
             case 4: arrayAccessing(&a);break;
             case 5: printf("*****Swaping*****\n");
                     printf("Before swaping a:%d\tb=%d\n",a,b);
                     swaping(&a,&b);
                     printf("After swaping a:%d\tb=%d\n\n",a,b);break;
            case 6:  exit(1);break;
         }
     }
     return 0;
 }
void callByValue(int,int);
void callByReference(int*,int*);


void callByValue(int a,int b)
{
    a++;b++;
    printf("Sum:%d\n",(a+b));
}
void callByReference(int*a,int*b)
{
    *a=*a+2;
    *b=*b+2;
    printf("Sum:%d\n",(*a+*b));
}

void createArray();
void arrayAccessing(int*);
void swaping(int*,int*);
int a[30],n;

void createArray()
{
   int i;
   printf("Enter the how many number you want to process:");
   scanf("%d",&n);
   for(i=0;i<=n;i++)
   {
       printf("%d-%d\n\n",i,(a+i));
   }
}

void arrayAccessing(int *a)
{
    int i;
    printf("****Array elements***\n");
    for(i=0;i<n;i++)
    {
        printf("%d\n\n",*(a+i));
    }
}
void swaping(int*a,int*b)
{
    int temp;
    temp=*a;
    *a=*b;
    *b=temp;
}


