#include<stdio.h>
#include<stdlib.h>
int main()
{
    int i,n,sum=0;
    int *ptra;
    printf("Enter how many number you need to process:\n");
    scanf("%d",&n);
    ptra=(int *)malloc(n*sizeof(int));
    if(i==0)
    {
        printf("memory allocation is failed!!!\n");

    }
    printf("Enter the %d elements:\n",n);
    for(i=0;i<n;i++)
    {
        scanf("%d",(ptra+i));
    }
    for(i=0;i<n;i++)
    {
        sum += *(ptra+i);
    }
    printf("sum is %d\n",sum);
    return 0;
}
