void memory()
{
    int *p,size1 ,c,i;
    printf("Enter the number of elements :\n");
    scanf("%d",&size1);
    p = (int*)calloc(size1,sizeof(int));
    printf("Enter the %d elements\n",size1);
    for(i=0;i<size1;i++)
        scanf("%d",p+i);
    printf("Entered elements are:\n");
    for(i=0;i<size1;i++)
        printf("%d\n",*(p+i));
        printf("Enter the how many extra element you want to add\n");
        scanf("%d",&c);
        p = (int*) realloc(p , c * sizeof(int));
        printf("Enter the %d elements\n",c);
        for(i=size1;i<(size1+c);i++)
            scanf("%d",p+i);
        printf("The elements after expand are:\n");
        for(i=0;i<(size1+c);i++)
            printf("%d\n",*(p+i));
}
