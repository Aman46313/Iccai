#include<stdio.h>
void addTwoNumbers(int,int);
void swaping(int*,int*);
int main()
{
    int a=5,b=10;
    addTwoNumbers(a,b);
    printf("Before swaping a:%d\t,b:%d\n",a,b);
    swaping(&a,&b);
    printf("After swaping a:%d\t,b:%d\n",a,b);
}
void addTwoNumbers(int a,int b)
{
    printf("Sum:%d\n",(a+b));
}
void swaping(int*m,int*n)
{
    int temp;
    temp=*m;
    *m=*n;
    *n=temp;
}
